# Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# Secrets and API credentials must NEVER be committed to version control.

# --- Multilingual Neural Retrieval (Phase 1) ---
# When false, falls back to lightweight TranslationHybridRetriever (BM25 + TF-IDF dense proxy).
ENABLE_BGE_M3=false
ENABLE_BGE_RERANKER=false
BGE_M3_MODEL_NAME=BAAI/bge-m3
BGE_RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

# --- Multilingual Query Translation (Phase 3) ---
# When false, falls back to deterministic local translation cache and offline civic dictionaries.
ENABLE_NLLB_LOCAL=false
NLLB_MODEL_NAME=facebook/nllb-200-distilled-600M
# Nigerian Pidgin strategy options: 'rule_mapped' (recommended, MRR 0.700), 'pass_through', or 'abstain'
PIDGIN_HANDLING_STRATEGY=rule_mapped

# --- WhatsApp Business Cloud API & Webhook (Phase 6) ---
# Secret for verifying Meta's X-Hub-Signature-256 HMAC header (empty allows mock tests)
WHATSAPP_APP_SECRET=""
# Token for Meta GET hub.challenge verification
WHATSAPP_VERIFY_TOKEN="inec_civic_verify_token_2026"
# Salt for privacy-preserving sender phone hashing (SHA-256)
SESSION_SALT="inec_hackathon_track3_salt_2026_audit"

# --- Speech Processing (Phase 7 - Stretch) ---
# Default to false for privacy, zero retention, and licensing compliance (CC-BY-NC 4.0 guardrails)
ENABLE_VOICE_ASR=false
ENABLE_VOICE_TTS=false

